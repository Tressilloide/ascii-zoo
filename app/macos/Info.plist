<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Descrizione dell'app per macOS. @VERSION@ viene sostituito dalla build con la versione di Cargo.toml -->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>ASCII Zoo</string>
  <key>CFBundleDisplayName</key>
  <string>ASCII Zoo</string>
  <key>CFBundleIdentifier</key>
  <string>io.github.tressilloide.asciizoo</string>
  <key>CFBundleExecutable</key>
  <string>ascii-zoo</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>@VERSION@</string>
  <key>CFBundleVersion</key>
  <string>@VERSION@</string>
  <key>LSMinimumSystemVersion</key>
  <string>11.0</string>
  <!-- niente icona nel Dock: l'app vive nella barra dei menu -->
  <key>LSUIElement</key>
  <true/>
  <key>NSHighResolutionCapable</key>
  <true/>
  <!-- widget "In riproduzione": AppleScript a Musica e Spotify, solo se sono già aperti -->
  <key>NSAppleEventsUsageDescription</key>
  <string>Il widget "In riproduzione" chiede a Musica e Spotify, se sono aperti, il titolo e l'artista del brano. Non li avvia e non li comanda.</string>
</dict>
</plist>
